# systemd unit for the RouteRest backend on an EC2 instance.
#
# What this is for: without this, the backend only runs while a terminal
# session is open, exactly like running it locally; it would die the
# moment you disconnect from the server or it reboots. systemd keeps it
# running in the background, restarts it if it crashes, and starts it
# automatically on boot.
#
# Install with (see ../DEPLOYMENT.md for the full walkthrough):
#   sudo cp routerest-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now routerest-backend
#
# Real database credentials and ALLOWED_ORIGINS are NOT in this file,
# they live in /etc/routerest/backend.env on the server (created during
# setup, never committed to git), loaded via EnvironmentFile below.

[Unit]
Description=RouteRest backend API
After=network.target

[Service]
Type=simple
User=routerest
WorkingDirectory=/home/routerest/RouteRest/backend
EnvironmentFile=/etc/routerest/backend.env
ExecStart=/home/routerest/.local/bin/uv run uvicorn backend.main:app --app-dir src --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
