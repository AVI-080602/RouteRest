# Copy this file to .env in the same folder and adjust if needed.
# .env itself is gitignored (see the repo root .gitignore); never commit
# real credentials, even local-only ones, to keep the habit consistent
# with how we will handle real API keys later.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=routerest
